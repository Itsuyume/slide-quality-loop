{
  "name": "slide-quality-loop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Constrained, evidence-bound review loop for rendered presentation slides",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run lint && npm test",
    "quality": "node dist/src/cli.js"
  },
  "dependencies": {
    "pngjs": "7.0.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
